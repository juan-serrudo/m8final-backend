# Environment Configuration for Monorepo
# Copy this file to .env and update the values as needed

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Application Settings
NODE_ENV=production
PORT=3000
ENV_ENTORNO=production
ENV_CORS=*
ENV_SWAGGER_SHOW=true
ENV_SYNCHRONIZE=false
APP_MAX_SIZE=10mb

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Hr3v1DXiEU409jIi
DB_NAME=password_manager

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Throttler Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# API Base URL for development
# In production, this will be handled by nginx proxy
VITE_API_BASE_URL=http://localhost:3000/api

# ===========================================
# DOCKER CONFIGURATION
# ===========================================

# Database credentials (for docker-compose)
POSTGRES_DB=password_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Hr3v1DXiEU409jIi

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================

# For local development, you can override these values
# Backend will run on port 3000
# Frontend will run on port 5173 (Vite default)
# Nginx proxy will run on port 80/8080