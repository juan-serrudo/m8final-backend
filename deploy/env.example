# Configuración de Entorno para Monorepo
# Copia este archivo a .env y actualiza los valores según sea necesario

# ===========================================
# CONFIGURACIÓN DEL BACKEND
# ===========================================

# Configuraciones de la Aplicación
NODE_ENV=production
PORT=3000
ENV_ENTORNO=production
ENV_CORS=*
ENV_SWAGGER_SHOW=true
ENV_SYNCHRONIZE=false
APP_MAX_SIZE=10mb

# Configuración de Base de Datos
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=password_manager

# Configuración de Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Configuración de Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ===========================================
# CONFIGURACIÓN DEL FRONTEND
# ===========================================

# URL Base de API para desarrollo
# En producción, esto será manejado por el proxy nginx
VITE_API_BASE_URL=http://localhost:3000/api

# ===========================================
# CONFIGURACIÓN DE DOCKER
# ===========================================

# Credenciales de base de datos (para docker compose)
POSTGRES_DB=password_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123

# ===========================================
# CONFIGURACIÓN DE ADMINER
# ===========================================

# Adminer estará disponible en:
# - Desarrollo: http://localhost:8081
# - Producción: http://localhost:8081
# 
# Credenciales para Adminer:
# - Sistema: PostgreSQL
# - Servidor: postgres (producción) / postgres-dev (desarrollo)
# - Usuario: postgres
# - Contraseña: password123
# - Base de datos: password_manager

# ===========================================
# CONFIGURACIÓN DE DESARROLLO
# ===========================================

# Para desarrollo local, puedes sobrescribir estos valores
# Backend se ejecutará en puerto 3000
# Frontend se ejecutará en puerto 5173 (por defecto de Vite)
# Proxy nginx se ejecutará en puerto 80/8080