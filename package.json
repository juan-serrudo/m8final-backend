{
  "name": "password-manager-monorepo",
  "version": "1.0.0",
  "description": "Password Manager - Secure password management system with NestJS backend and React frontend",
  "private": true,
  "author": "Juan Victor Serrudo Chavez",
  "license": "MIT",
  "contact": {
    "name": "Juan Victor",
    "email": "juan.serrudo@ucb.edu.bo"
  },
  "scripts": {
    "start": "./deploy/start.sh",
    "stop": "./deploy/stop.sh",
    "health": "./deploy/health-check.sh",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:all": "npm run lint:backend && npm run lint:frontend",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "clean": "docker-compose down -v --rmi all && docker system prune -f"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "password-manager",
    "nestjs",
    "react",
    "vite",
    "docker",
    "monorepo",
    "security",
    "encryption"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/password-manager-monorepo.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/password-manager-monorepo/issues"
  },
  "homepage": "https://github.com/your-username/password-manager-monorepo#readme"
}
